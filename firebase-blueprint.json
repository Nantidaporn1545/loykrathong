{
  "entities": {
    "krathong": {
      "title": "Krathong",
      "description": "Floating Krathong created by an employee with wishes and visual styling",
      "type": "object",
      "properties": {
        "nickname": {
          "type": "string",
          "maxLength": 100
        },
        "department": {
          "type": "string",
          "maxLength": 100
        },
        "style": {
          "type": "string",
          "enum": ["traditional", "lotus", "golden_lotus", "eco_coconut"]
        },
        "color": {
          "type": "string",
          "enum": ["gold", "pink", "blue", "purple", "emerald"]
        },
        "decorations": {
          "type": "object"
        },
        "wish": {
          "type": "string",
          "maxLength": 1000
        },
        "timestamp": {
          "type": "number"
        },
        "xPercent": {
          "type": "number"
        },
        "speed": {
          "type": "number"
        },
        "likes": {
          "type": "number"
        }
      },
      "required": [
        "nickname",
        "style",
        "color",
        "decorations",
        "wish",
        "timestamp",
        "xPercent",
        "speed",
        "likes"
      ]
    },
    "krathongLike": {
      "title": "KrathongLike",
      "description": "Single-like lock record per voterId for a Krathong",
      "type": "object",
      "properties": {
        "voterId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "number"
        }
      },
      "required": [
        "voterId",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/krathongs/{krathongId}": {
      "schema": "krathong",
      "description": "Legacy collection of previous employee floated krathongs"
    },
    "/krathongs_v2/{krathongId}": {
      "schema": "krathong",
      "description": "Active collection of public employee floated krathongs starting fresh from 0"
    },
    "/krathongs_v2/{krathongId}/likes/{voterId}": {
      "schema": "krathongLike",
      "description": "Per-voter single-like record preventing duplicate likes on any Krathong"
    }
  }
}
